// EasyCut AI — data model.
//
// The shape is driven by one decision: the EDL is versioned, and everything
// else points at it. Undo, A/B variants, "regenerate just the B-roll" and
// re-rendering a different aspect ratio are then all the same operation —
// write a new Edl row against the same source asset.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for a zero-setup clone, Postgres in production. Prisma will not read
  // this from an env var, so `npm run db:postgres` rewrites the line — see
  // scripts/use-postgres.ts. Deploying with sqlite left in place gives you a
  // database on a container filesystem that is wiped on every restart.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  projects  Project[]

  // ── subscription ──────────────────────────────────────────────────────
  // See src/lib/billing/plans.ts. A row written before plans existed reads as
  // "free", which is the safe direction to be wrong in.
  plan             String  @default("free")
  stripeCustomerId String? @unique

  // The live subscription, when there is one. Kept so the account page can
  // say what happens next without a round trip to Stripe on every page load,
  // and so a webhook arriving out of order can be recognised as stale.
  stripeSubscriptionId String?   @unique
  // "active" | "trialing" | "past_due" | "canceled" | null when never paid.
  planStatus           String?
  // When the current period ends: the renewal date, or — when cancelAtPeriodEnd
  // is true — the day the account drops back to free.
  planRenewsAt         DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // Stripe's own timestamp for the event that last wrote these columns.
  // Webhooks are delivered at least once and not necessarily in order, so an
  // older event must never overwrite a newer one.
  planUpdatedAt        DateTime?

  // The meter. `periodStart` rolls forward a month at a time the first time
  // anybody looks after it has expired — see src/lib/billing/usage.ts — so
  // there is no cron to forget and no clock skew between two workers.
  periodStart DateTime @default(now())
  minutesUsed Float    @default(0)
}

model Project {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  title String @default("Untitled")

  // What the user chose on upload — the only three decisions they make.
  mode      String // "short" | "long"
  styleId   String @default("clean")
  inputMode String @default("raw") // "raw" | "roughcut"

  // The caption look, when the user picked one rather than taking the style's.
  // Null means "whatever this edit style defaults to", which is what makes the
  // two lists independent — see src/lib/captions/presets.ts.
  captionPreset String?

  // Optional free-text steer, e.g. "focus on the pricing section".
  userNote String?

  // Layers the person declined before anything was made, as a JSON array of
  // names. Only the refusals are stored: everything is on unless it was
  // switched off, and a record spelling out six `true`s says nothing the
  // absence did not.
  layersOff String @default("[]")

  status       String  @default("draft") // draft | processing | ready | failed
  errorMessage String?

  // Denormalised so the dashboard never has to join to render a card.
  durationSec   Float?
  thumbnailUrl  String?
  previewUrl    String?
  socialCaption String?
  hashtags      String  @default("[]") // JSON array

  // Accumulated real spend, so unit economics are observable per project.
  costUsd    Float  @default(0)
  costReport String @default("{}") // JSON: CostLedger

  // The expensive analysis, cached.
  //
  // Transcription and the AI director are the only two stages that cost money
  // per run. Keeping their outputs means restyling, re-cutting, changing aspect
  // ratio, or spinning a short out of a long-form video are all FREE — they
  // replay the cheap deterministic half of the pipeline and re-render. This is
  // the single most valuable thing in the schema.
  transcriptJson   String @default("{}") // JSON: Transcript
  directorPlanJson String @default("{}") // JSON: DirectorPlan
  mediaJson        String @default("{}") // JSON: MediaInfo from ffprobe
  cutsJson         String @default("[]") // JSON: Interval[] — mechanical removals

  // ── retention ─────────────────────────────────────────────────────────
  // The plan the footage was uploaded under, so a later downgrade cannot
  // retroactively shorten the promise somebody already paid for. The expiry
  // dates are stored rather than derived: the sweeper wants an index, and a
  // stored date can be extended for one project without special-casing.
  planAtUpload     String    @default("free")
  sourceMinutes    Float     @default(0)
  sourceExpiresAt  DateTime?
  sourceDeletedAt  DateTime?
  renderExpiresAt  DateTime?
  rendersDeletedAt DateTime?

  // Set once the "your video is ready" email has gone out, so a re-render or a
  // restarted worker cannot send it twice.
  readyEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets  Asset[]
  jobs    Job[]
  edls    Edl[]
  renders Render[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([sourceExpiresAt])
  @@index([renderExpiresAt])
}

model Asset {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // source | proxy | audio | render | thumbnail | broll | graphic | music
  kind        String
  storageKey  String
  url         String
  contentType String
  sizeBytes   Int    @default(0)

  // Probe results, for source and render assets.
  width       Int?
  height      Int?
  fps         Float?
  durationSec Float?

  // Provider attribution for anything third-party (stock clips, music).
  attribution String?

  createdAt DateTime @default(now())

  @@index([projectId, kind])
}

model Job {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type   String @default("pipeline") // pipeline | rerender | patch
  status String @default("queued") // queued | running | succeeded | failed | cancelled

  // The pipeline is resumable: this is the last stage that completed.
  stage         String @default("ingest")
  progress      Float  @default(0) // 0..1
  progressLabel String @default("")

  // Per-stage timings and messages, appended as the job runs.
  log String @default("[]") // JSON: Array<{stage, status, ms, message}>

  errorMessage String?
  attempts     Int     @default(0)

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([projectId, queuedAt])
  @@index([status])
}

model Edl {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  version  Int    @default(1)
  // The full EDL document. Kept as JSON rather than normalised: it is read and
  // written whole, always, and normalising it would buy nothing but joins.
  document String

  // Where this version came from, so the editor can show a history.
  origin String @default("pipeline") // pipeline | user-edit | regenerate

  createdAt DateTime @default(now())

  renders Render[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model Render {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edlId     String
  edl       Edl     @relation(fields: [edlId], references: [id], onDelete: Cascade)

  aspect String // "9:16" | "1:1" | "16:9" | "4:5"
  width  Int
  height Int
  fps    Float  @default(30)

  status   String @default("queued") // queued | running | succeeded | failed
  progress Float  @default(0)

  url          String?
  sizeBytes    Int     @default(0)
  durationSec  Float?
  costUsd      Float   @default(0)
  renderMs     Int?
  errorMessage String?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([projectId, createdAt])
}

/// The queue, when Redis is not worth a second service.
///
/// Postgres is already there, and a table is a perfectly good queue at the
/// volume one machine can render. Reserving is an optimistic claim — update the
/// row only if it is still queued — so two workers racing for the same job
/// means one of them gets zero rows back and moves on.
model QueueMessage {
  id          String    @id @default(uuid())
  type        String
  payload     String    @default("{}")
  status      String    @default("queued") // queued | running | dead
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  enqueuedAt  DateTime  @default(now())
  reservedAt  DateTime?
  lastError   String?
  // Higher goes first — see src/lib/queue/index.ts. 0 for everybody, 1 for a
  // plan that paid to jump the queue.
  priority    Int       @default(0)

  @@index([status, priority, enqueuedAt])
}
