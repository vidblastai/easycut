{
  "name": "easycut",
  "version": "0.1.0",
  "private": true,
  "description": "EasyCut AI — upload your footage, get a finished video.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
