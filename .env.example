# ─────────────────────────────────────────────────────────────────────────────
# EasyCut AI
#
# EVERY KEY BELOW IS OPTIONAL. With none of them set, the app still runs end to
# end and produces a finished video — it just has fewer layers. Run
# `npm run doctor` at any point to see exactly what is on and what each missing
# key would add.
#
# The two that change the output most, in order: DEEPGRAM_API_KEY (captions and
# filler removal) and ANTHROPIC_API_KEY (the AI director).
# ─────────────────────────────────────────────────────────────────────────────

APP_URL=http://localhost:3000

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Leave both blank and the app runs OPEN — fine for a local clone, never for a
# deployment: every project is reachable by anyone who guesses its id.
# /api/health warns while that is the case.
#   https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL="file:./dev.db"

# ── Transcription ────────────────────────────────────────────────────────────
# Pick one. Deepgram is the default because it returns "um"/"uh" as real tokens
# with timestamps, which is what makes filler removal possible.
#   Deepgram Nova-3   $0.0043/min   https://console.deepgram.com/signup
#   Groq Whisper      $0.04/hour    https://console.groq.com/keys
#   AssemblyAI        $0.12/hour    https://www.assemblyai.com/dashboard/signup
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ASSEMBLYAI_API_KEY=
ASR_PROVIDER=auto

# ── The AI director ──────────────────────────────────────────────────────────
# Chooses the hook, the cuts, the B-roll, the graphics and the emphasis.
# Without it, a rule-based editor takes over — competent, less clever.
#
# Two providers, same prompt, same plan schema, same validation — so you can run
# the same footage through both and judge the difference yourself.
#   auto (default) uses whichever key is set, preferring Anthropic when both are.
LLM_PROVIDER=auto

#   https://console.anthropic.com/     ~$0.10 per 45s short on Opus 5
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max — medium keeps the job fast, high is more considered.
LLM_EFFORT=medium

#   https://aistudio.google.com/apikey     free tier, rate-limited to a few
#   requests a minute — which is fine for a short and slow for long-form,
#   because each 3-minute window becomes its own sequential call.
#
#   READ THIS BEFORE USING THE FREE TIER: Google may use free-tier prompts and
#   responses to improve its products. The prompt here is your transcript —
#   your unpublished script. Link a billing account and set GEMINI_PAID_TIER=true
#   to opt out; `npm run doctor` reprints this warning while it applies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash
GEMINI_PAID_TIER=false

# ── B-roll (free) ────────────────────────────────────────────────────────────
# Both are free with no paid tier. Pexels allows 200 requests an hour and 20,000
# a month by default and will lift that on request if you attribute properly;
# one short uses two or three. Pixabay is a second source for when Pexels has
# nothing for a query, not a fallback for running out of quota.
#   https://www.pexels.com/api/       https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Generated illustrations ──────────────────────────────────────────────────
# Only used for the one or two cues an icon can't cover. ~$0.003 an image.
#   https://replicate.com/account/api-tokens     https://fal.ai/dashboard/keys
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
FAL_KEY=
IMAGEGEN_PROVIDER=auto

# ── Storage ──────────────────────────────────────────────────────────────────
# `local` writes to ./.storage and is fine for one machine. For anything real,
# use Cloudflare R2: S3-compatible with zero egress fees, which matters when
# every finished video gets downloaded.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Queue ────────────────────────────────────────────────────────────────────
# `memory` loses queued jobs on restart. Use Redis for more than one worker.
# Using the redis driver also needs its client: npm install redis
# memory — one process only, lost on restart. Fine for `npm run dev`.
# db     — the Postgres you already have. Works across processes and containers,
#          needs no extra service, and is the right answer until there are many
#          workers.
# redis  — for when there are.
QUEUE_DRIVER=memory
REDIS_URL=
QUEUE_CONCURRENCY=2

# ── Rendering ────────────────────────────────────────────────────────────────
# `local` renders on this machine (correct, ~8× slower for long-form).
# `lambda` fans frame ranges across AWS Lambda — a 10-minute video in ~2 minutes.
#   https://www.remotion.dev/docs/lambda/setup
RENDER_DRIVER=local
# Browser tabs rendering frames at once. Blank derives it from the CPUs
# present (cores - 1, capped at 4) — a flat 4 is two too many on a
# single-vCPU container, where four headless Chromes contending for one core
# is slower than one.
RENDER_CONCURRENCY=
# Ceiling on Remotion's decoded-frame cache, in MB. Left to Remotion this is a
# share of the host's free memory, which makes the same render behave
# differently on every machine it lands on.
RENDER_OFFTHREAD_CACHE_MB=512
# Remotion downloads its own headless Chromium on first render. If the host
# blocks that, or already ships a browser, point at it here.
BROWSER_EXECUTABLE=
# Set on render hosts behind a TLS-intercepting proxy, where the headless
# browser would otherwise reject every remote asset it fetches.
RENDER_IGNORE_CERT_ERRORS=false
REMOTION_LAMBDA_FUNCTION=
REMOTION_SERVE_URL=
REMOTION_LAMBDA_REGION=us-east-1
RENDER_FRAMES_PER_LAMBDA=80
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Payments ─────────────────────────────────────────────────────────────────
# Optional, like everything else. With no key the plans still exist and are
# still enforced — allowances, retention, concurrency, the watermark — they
# simply cannot be bought, which is exactly the shape of a free beta: set
# somebody's `plan` column by hand and the product behaves identically.
#
# Live keys start sk_live_ / price_ and the webhook secret whsec_. Get all of
# them from dashboard.stripe.com, and point a webhook endpoint at
#   https://your-domain/api/billing/webhook
# subscribed to: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
#
# Also switch the customer portal on once, at
# dashboard.stripe.com/settings/billing/portal — without it, "Manage
# subscription" opens nothing and the error says exactly this.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One recurring monthly price per plan. Ids are per-account and per-mode, so
# test-mode ids will not work against a live key.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
# The same three plans billed once a year, at a fifth off: $288, $719.88 and
# $1,824. Optional — leave them blank and the site sells monthly only, and the
# annual cards say so instead of charging the wrong interval. In Stripe these
# are a SECOND price on the same three products, not new products.
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_CREATOR_ANNUAL=
STRIPE_PRICE_STUDIO_ANNUAL=

# ── Budget guard ─────────────────────────────────────────────────────────────
# Hard ceilings, enforced in code. A job that would exceed one drops its most
# expensive optional layers rather than overspending.
MAX_COST_SHORT_USD=1
MAX_COST_LONG_USD=5
MAX_UPLOAD_MB=4096
MAX_SHORT_DURATION_SEC=90
MAX_LONG_DURATION_SEC=600

# ── Feature switches ─────────────────────────────────────────────────────────
FEATURE_REFRAME=true
FEATURE_BROLL=true
FEATURE_GENERATED_IMAGES=true
FEATURE_MUSIC=true
