# ─────────────────────────────────────────────────────────────────────────────
# EasyCut AI
#
# EVERY KEY BELOW IS OPTIONAL. With none of them set, the app still runs end to
# end and produces a finished video — it just has fewer layers. Run
# `npm run doctor` at any point to see exactly what is on and what each missing
# key would add.
#
# The two that change the output most, in order: DEEPGRAM_API_KEY (captions and
# filler removal) and ANTHROPIC_API_KEY (the AI director).
# ─────────────────────────────────────────────────────────────────────────────

APP_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"

# ── Transcription ────────────────────────────────────────────────────────────
# Pick one. Deepgram is the default because it returns "um"/"uh" as real tokens
# with timestamps, which is what makes filler removal possible.
#   Deepgram Nova-3   $0.0043/min   https://console.deepgram.com/signup
#   Groq Whisper      $0.04/hour    https://console.groq.com/keys
#   AssemblyAI        $0.12/hour    https://www.assemblyai.com/dashboard/signup
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ASSEMBLYAI_API_KEY=
ASR_PROVIDER=auto

# ── The AI director ──────────────────────────────────────────────────────────
# Chooses the hook, the cuts, the B-roll, the graphics and the emphasis.
# Without it, a rule-based editor takes over — competent, less clever.
#   https://console.anthropic.com/
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max — medium keeps the job fast, high is more considered.
LLM_EFFORT=medium

# ── B-roll (free) ────────────────────────────────────────────────────────────
#   https://www.pexels.com/api/       https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Generated illustrations ──────────────────────────────────────────────────
# Only used for the one or two cues an icon can't cover. ~$0.003 an image.
#   https://replicate.com/account/api-tokens     https://fal.ai/dashboard/keys
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
FAL_KEY=
IMAGEGEN_PROVIDER=auto

# ── Storage ──────────────────────────────────────────────────────────────────
# `local` writes to ./.storage and is fine for one machine. For anything real,
# use Cloudflare R2: S3-compatible with zero egress fees, which matters when
# every finished video gets downloaded.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Queue ────────────────────────────────────────────────────────────────────
# `memory` loses queued jobs on restart. Use Redis for more than one worker.
# Using the redis driver also needs its client: npm install redis
QUEUE_DRIVER=memory
REDIS_URL=
QUEUE_CONCURRENCY=2

# ── Rendering ────────────────────────────────────────────────────────────────
# `local` renders on this machine (correct, ~8× slower for long-form).
# `lambda` fans frame ranges across AWS Lambda — a 10-minute video in ~2 minutes.
#   https://www.remotion.dev/docs/lambda/setup
RENDER_DRIVER=local
RENDER_CONCURRENCY=4
# Remotion downloads its own headless Chromium on first render. If the host
# blocks that, or already ships a browser, point at it here.
BROWSER_EXECUTABLE=
# Set on render hosts behind a TLS-intercepting proxy, where the headless
# browser would otherwise reject every remote asset it fetches.
RENDER_IGNORE_CERT_ERRORS=false
REMOTION_LAMBDA_FUNCTION=
REMOTION_SERVE_URL=
REMOTION_LAMBDA_REGION=us-east-1
RENDER_FRAMES_PER_LAMBDA=80
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Budget guard ─────────────────────────────────────────────────────────────
# Hard ceilings, enforced in code. A job that would exceed one drops its most
# expensive optional layers rather than overspending.
MAX_COST_SHORT_USD=1
MAX_COST_LONG_USD=5
MAX_UPLOAD_MB=4096
MAX_SHORT_DURATION_SEC=90
MAX_LONG_DURATION_SEC=600

# ── Feature switches ─────────────────────────────────────────────────────────
FEATURE_REFRAME=true
FEATURE_BROLL=true
FEATURE_GENERATED_IMAGES=true
FEATURE_MUSIC=true
